# Copy to .env and fill in from the Supabase dashboard
# (Project Settings -> API). These are PUBLISHABLE keys: they ship in the
# browser bundle by design and are safe to expose. Never put a service_role
# key or any private API key in this file.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
